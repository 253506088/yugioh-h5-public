{
  "name": "yugioh-duel-sanctuary",
  "version": "4.1.0",
  "private": true,
  "description": "A single-file Yu-Gi-Oh! tribute game with offline rules and Chinese, English and Japanese text",
  "scripts": {
    "art": "node scripts/generate-art.mjs",
    "build": "node scripts/build.mjs",
    "build:no-art": "node scripts/build.mjs --no-art --out output/no-art/index.html",
    "cards:import": "node scripts/import-early-cards.mjs",
    "cards:coverage": "node scripts/report-card-coverage.mjs",
    "locales:sync": "node scripts/sync-locales.mjs --offline",
    "locales:update": "node scripts/sync-locales.mjs --refresh",
    "report": "node scripts/delivery-report.mjs",
    "cards:year": "node scripts/prepare-year.mjs",
    "collect:years": "node scripts/collect-years.mjs",
    "art:collect": "node scripts/collect-game-art.mjs",
    "art:plan": "node scripts/collect-game-art.mjs --plan",
    "audio:collect": "node scripts/collect-experience-audio.mjs",
    "art:experience": "node scripts/collect-experience-art.mjs",
    "test:experience": "node --test tests/experience.test.cjs && node tests/experience-browser.cjs && node tests/experience-layout-browser.cjs && node tests/experience-response-browser.cjs",
    "test:tournament": "node --test tests/tournament.test.cjs && node tests/tournament-browser.cjs",
    "test:ai": "node --test tests/ai-marginal.test.cjs && node tests/ai-marginal-browser.cjs",
    "start": "node scripts/serve.mjs",
    "test": "node scripts/run-checks.mjs",
    "test:rules": "node --test tests/engine.test.cjs tests/v2-core.test.cjs tests/v2-regression.test.cjs tests/v3-rules.test.cjs tests/v4-rules.test.cjs tests/v4-2002.test.cjs tests/v4-2002-sweep.test.cjs tests/v4-2003.test.cjs tests/v4-2003-sweep.test.cjs tests/v4-2004.test.cjs tests/v4-2004-sweep.test.cjs tests/v4-2005.test.cjs tests/v4-2005-sweep.test.cjs",
    "test:2002-sweep": "node --test tests/v4-2002-sweep.test.cjs",
    "test:assets": "node --test tests/yearly-collector.test.mjs tests/game-art.test.mjs tests/collection-progress.test.mjs",
    "test:i18n": "node --test tests/i18n.test.cjs",
    "test:simulation": "node tests/v2-simulation.cjs",
    "test:v2-browser": "node tests/v2-browser.cjs",
    "test:browser": "node tests/v4-browser.cjs && node tests/v4.1-browser.cjs",
    "test:localization-browser": "node tests/v4.1-browser.cjs",
    "test:ui-audit": "node tests/i18n-audit.cjs",
    "test:interaction": "npm run test:browser",
    "test:visual": "npm run test:browser",
    "test:v4-simulation": "node tests/v4-simulation.cjs",
    "test:v3-simulation": "node tests/v3-simulation.cjs",
    "test:v3-browser": "node tests/v3-browser.cjs",
    "test:mixed": "node tests/v2-mixed-simulation.cjs",
    "test:years": "node --test tests/v4-2003.test.cjs tests/v4-2003-sweep.test.cjs tests/v4-2004.test.cjs tests/v4-2004-sweep.test.cjs tests/v4-2005.test.cjs tests/v4-2005-sweep.test.cjs",
    "test:years:browser": "node tests/yearly-browser.cjs",
    "test:years:simulation": "node tests/yearly-simulation.cjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "playwright-core": "^1.63.0",
    "sharp": "0.35.4"
  }
}
