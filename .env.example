# Docker Compose configuration. For node/npm, set shell environment variables
# or use node --env-file=.env server/index.mjs instead.
DUEL_PORT=4173
DUEL_BIND_ADDRESS=127.0.0.1
DUEL_MAX_ROOMS=100

# Set a real DNS name before running: docker compose --profile https up -d --build
DUEL_DOMAIN=duel.example.com

# Enable only behind a trusted proxy, with direct backend access restricted.
DUEL_TRUST_PROXY=0
# Optional comma-separated WebSocket frontend origins. Same-origin works by default.
DUEL_ORIGINS=
