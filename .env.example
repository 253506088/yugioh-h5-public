# Docker Compose configuration. For node/npm, set shell environment variables
# or use node --env-file=.env server/index.mjs instead.
DUEL_PORT=4173
DUEL_BIND_ADDRESS=127.0.0.1
DUEL_MAX_ROOMS=100

# Set a real DNS name before running: docker compose --profile https up -d --build
DUEL_DOMAIN=duel.example.com

# Enable only behind a trusted proxy, with direct backend access restricted.
DUEL_TRUST_PROXY=0
# Optional comma-separated WebSocket frontend origins. Same-origin works by default.
DUEL_ORIGINS=

# Optional AI import proxy. Empty allowlist permits public HTTPS hosts only.
# Comma-separated hostnames (include :port when using a non-default HTTPS port).
DUEL_AI_UPSTREAMS=
# Hosted keys are disabled unless KEY, URL and MODEL are all supplied.
# Keep real keys in your shell or ignored .env.local, never in this example.
DUEL_AI_DEFAULT_KEY=
DUEL_AI_DEFAULT_URL=
DUEL_AI_DEFAULT_MODEL=
DUEL_AI_DEFAULT_PROTOCOL=openai
DUEL_AI_DEFAULT_ENDPOINT=responses
# Hosted requests per IP per hour. All AI routes also have concurrency/rate limits.
DUEL_AI_HOURLY_LIMIT=30
